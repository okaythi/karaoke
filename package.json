{
  "name": "karaoke-theater",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "npm run build && npm run verify:protected-build && wrangler pages deploy dist --project-name karaoke --branch main",
    "sync:server": "tsx scripts/sync-server.ts",
    "sync:links": "tsx scripts/generate-share-links.ts",
    "test:notation": "node --import tsx --test src/notation/tests/*.test.ts",
    "test:player": "node --import tsx --test src/player/tests/*.test.ts",
    "fonts:notation": "python3 scripts/notation/build-fonts.py",
    "import:score": "tsx scripts/notation/import-song.ts",
    "test:security": "node --import tsx --test src/server/tests/*.test.js",
    "verify:protected-build": "node scripts/verify-protected-build.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.4.2",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^26.5.1",
    "tsx": "^4.19.3",
    "vexflow": "^5.0.0",
    "wrangler": "^4.86.0"
  }
}

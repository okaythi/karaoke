# karaoke.desktop — copy to ~/.local/share/applications/ (all users:
# /usr/share/applications/) and copy the hicolor/ tree next to your theme
# icons (~/.local/share/icons/ or /usr/share/icons/). Adjust Exec to the
# real command that starts the application.
[Desktop Entry]
Type=Application
Version=1.0
Name=Karaoke by Thy
Exec=karaoke
Icon=karaoke
Terminal=false
Categories=Utility;

---
// The slide-out song list: brand, search, the Lyrics/Piano switch and the list itself.
---
<aside class="theater-sidebar" id="theater-sidebar">
  <div class="sidebar-header">
    <div class="brand-container">
      <div class="brand-logo-frame" id="brand-logo-frame" aria-label="Karaoke by Thy">
        <svg class="brand-logo-image brand-logo-standard" viewBox="0 0 200 34" width="200" height="34" role="img" aria-label="Karaoke by Thy">
          <text x="0" y="23" font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-weight="800" font-size="19" letter-spacing="-0.02em" fill="#f5f0e6">KARAOKE</text>
          <rect x="103" y="10.5" width="1.5" height="13" rx="0.75" fill="#deb668" opacity="0.45" />
          <text x="113" y="21.5" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="500" fill="#9a9183" letter-spacing="0.02em">by <tspan fill="#deb668" font-weight="600">Thy</tspan></text>
        </svg>
        <svg class="brand-logo-image brand-logo-japanese" viewBox="0 0 200 34" width="200" height="34" role="img" aria-label="Karaoke by Thy">
          <text x="0" y="23" font-family="'Noto Sans JP', 'Hiragino Sans', 'Meiryo', sans-serif" font-weight="900" font-size="19" letter-spacing="0.04em" fill="#f5f0e6">カラオケ</text>
          <rect x="103" y="10.5" width="1.5" height="13" rx="0.75" fill="#deb668" opacity="0.45" />
          <text x="113" y="21.5" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="500" fill="#9a9183" letter-spacing="0.02em">by <tspan fill="#deb668" font-weight="600">Thy</tspan></text>
        </svg>
      </div>
    </div>
  </div>

  <div class="search-pill-container">
    <div class="search-pill">
      <svg class="search-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="search-pill-input" placeholder="Search songs or artists..." autocomplete="off" spellcheck="false" />
      <button class="search-pill-clear" id="search-pill-clear" title="Clear Search" hidden>✕</button>
    </div>
    <!-- Sing along to lyrics, or play along to a piano score. -->
    <div class="library-mode" id="library-mode" role="radiogroup" aria-label="Library">
      <input class="library-mode-input" type="radio" name="library-mode" id="library-mode-lyrics" value="lyrics" checked disabled />
      <label class="library-mode-option" for="library-mode-lyrics">
        <svg class="library-mode-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
        <span>Lyrics</span>
        <span class="library-mode-count" id="library-mode-lyrics-count"></span>
      </label>
      <input class="library-mode-input" type="radio" name="library-mode" id="library-mode-piano" value="piano" disabled />
      <label class="library-mode-option" for="library-mode-piano">
        <svg class="library-mode-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M9 14v5M15 14v5"/><path d="M9 5v8M15 5v8" stroke-width="3.5" stroke-linecap="butt"/></svg>
        <span>Piano</span>
        <span class="library-mode-count" id="library-mode-piano-count"></span>
      </label>
      <span class="library-mode-thumb" aria-hidden="true"></span>
    </div>
    <span class="visually-hidden" id="song-list-status" role="status">Loading tracks...</span>
  </div>

  <div class="sidebar-song-list" id="sidebar-song-list"></div>

  <!-- Pull tab for the swipeable drawer -->
  <button class="drawer-handle" id="drawer-handle" type="button" aria-label="Song list" aria-controls="theater-sidebar" aria-expanded="false"></button>
</aside>

<div class="drawer-scrim" id="drawer-scrim" aria-hidden="true"></div>

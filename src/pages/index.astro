---
import LibraryDrawer from '../components/theater/LibraryDrawer.astro';
import TrackHeader from '../components/theater/TrackHeader.astro';
import TransportDeck from '../components/theater/TransportDeck.astro';
import '../styles/global.css';
import '../styles/theater.css';
import '../notation/render/notation.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Music · Nix</title>
  <link rel="privacy-policy" href="/privacy" />
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
  <meta name="googlebot" content="noindex, nofollow, nosnippet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script is:inline>
    let musicVisitor = location.hostname === 'music.sudothy.me';
    try { musicVisitor ||= new URL(document.referrer).hostname === 'music.sudothy.me'; } catch { /* no referrer */ }
    try {
      musicVisitor ||= sessionStorage.getItem('karaoke-music-visitor') === '1';
      if (musicVisitor) sessionStorage.setItem('karaoke-music-visitor', '1');
    } catch { /* storage blocked: the hostname and referrer checks still apply */ }
    document.documentElement.classList.toggle('music-visitor', musicVisitor);
    document.title = musicVisitor ? 'Music · Thy' : 'Music · Nix';
  </script>
  <script is:inline src="https://accounts.nixlabs.tech/widget.js" async></script>
  <script is:inline>
    // Disable text selection and drag
    document.addEventListener('selectstart', e => e.preventDefault());
    document.addEventListener('dragstart', e => e.preventDefault());

    // Disable context menu (right click)
    document.addEventListener('contextmenu', e => e.preventDefault());

    // Disable DevTools inspection hotkeys
    document.addEventListener('keydown', e => {
      if (
        e.key === 'F12' ||
        ((e.ctrlKey || e.metaKey) && (e.key === 'u' || e.key === 'U' || e.key === 's' || e.key === 'S')) ||
        ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'I' || e.key === 'i' || e.key === 'J' || e.key === 'j' || e.key === 'C' || e.key === 'c'))
      ) {
        e.preventDefault();
        e.stopPropagation();
        return false;
      }
    });

    // Suppress console output
    try {
      console.log = () => {};
      console.debug = () => {};
      console.info = () => {};
    } catch { /* console is read-only here */ }
  </script>
</head>
<body>

  <div class="theater-app">
    <LibraryDrawer />

    <main class="theater-stage">
      <TrackHeader />

      <section class="video-stage-wrapper" id="video-stage-wrapper">
        <div class="video-frame-container">
          <video id="theater-video" playsinline preload="auto"></video>
          <p id="playback-status" class="playback-status" role="status" aria-live="polite" hidden></p>
          <button class="center-play-overlay" id="center-play-btn" title="Play Video" aria-label="Play Video">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><polygon points="7 4 19 12 7 20 7 4"/></svg>
          </button>
        </div>
      </section>

      <!-- Lyrics and score, centred between the video and the deck on phones -->
      <div class="stage-middle" id="stage-middle">
        <section class="lyrics-stage-container" id="lyrics-stage-container">
          <div id="k-line-top" class="k-line k-line-top"></div>
          <div id="k-line-bottom" class="k-line k-line-bottom"></div>
        </section>

        <section class="piano-score-container" id="piano-score-container" aria-label="Piano karaoke score" hidden></section>
      </div>

      <TransportDeck />
    </main>
  </div>

  <!-- Pointer-following tips sit outside the app so no ancestor clips or offsets them. -->
  <div id="voice-pointer-pill" class="voice-pointer-pill" hidden>Remove Vocals</div>
  <div id="vote-tooltip" class="vote-tooltip" role="tooltip" hidden>Logged in users can like songs.</div>

  <script>
    import { initKaraokeTheater } from '../player/karaokePlayer';
    import { createSwipeDrawer } from '../player/swipeDrawer';
    import { initMusicVisitorControls } from '../player/musicVisitor';
    import { byId } from '../player/dom';

    document.addEventListener('DOMContentLoaded', () => {
      initMusicVisitorControls();
      const drawer = createSwipeDrawer({
        app: document.querySelector<HTMLElement>('.theater-app')!,
        drawer: byId('theater-sidebar'),
        handle: byId<HTMLButtonElement>('drawer-handle'),
        scrim: byId('drawer-scrim'),
        toggle: byId<HTMLButtonElement>('mobile-queue-btn')
      });
      initKaraokeTheater({ showLibrary: drawer.open });
    });
  </script>
</body>
</html>
